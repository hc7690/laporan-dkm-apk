<?xml version='1.0' encoding='utf-8'?>
<widget id="com.dkm.laporan" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Laporan DKM</name>
    <description>Sistem Laporan Keuangan DKM Masjid</description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <!-- ICON APLIKASI -->
    <icon src="icon.png" /> 
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Plugin yang dibutuhkan -->
    <plugin name="cordova-plugin-file" spec="^8.1.3" />
    <plugin name="cordova-plugin-file-opener2" spec="^4.0.0" />
    <plugin name="cordova-plugin-androidx-adapter" spec="^1.1.3" />
</widget>
